# Copy to .env.local for local dev; set the same keys in Vercel for production.
# Never commit real values — .env.local is gitignored.

# --- /admin auth (Auth.js / NextAuth v5, Google sign-in) ---
# Random signing secret. Generate: openssl rand -base64 33
AUTH_SECRET=
# Google OAuth client — console.cloud.google.com → Credentials → OAuth client ID → Web application.
# Authorized redirect URIs (must match EXACTLY):
#   https://portfolio-six-theta-gpq4no7ad9.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only this Google email may access /admin. Defaults to jpranshu36@gmail.com if unset.
ADMIN_EMAIL=

# --- /admin funnel tracker (Neon Postgres) ---
# Set automatically by the Vercel → Storage → Neon integration.
DATABASE_URL=

# --- existing site features ---
GEMINI_API_KEY=
RESEND_API_KEY=
